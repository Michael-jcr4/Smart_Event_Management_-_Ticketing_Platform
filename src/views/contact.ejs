<%- include("partials/head") %>

<section class="page-heading">
  <h2>Contact us</h2>
  <p>Questions about an event, a booking or ticket availability? Send us an enquiry.</p>
</section>

<section class="contact-grid">
  <div class="card">
    <h3>Submit an enquiry</h3>

    <%- include("partials/errors") %>

    <form action="/contact" method="POST">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div class="form-group">
        <label for="name">Full name</label>
        <input type="text" id="name" name="name" value="<%= values.name || "" %>" maxlength="80" required>
      </div>

      <div class="form-group">
        <label for="email">Email address</label>
        <input type="email" id="email" name="email" value="<%= values.email || "" %>" required>
      </div>

      <div class="form-group">
        <label for="subject">Subject</label>
        <input type="text" id="subject" name="subject" value="<%= values.subject || "" %>" placeholder="e.g. Problem with my booking" maxlength="150" required>
      </div>

      <div class="form-group">
        <label for="message">Message</label>
        <textarea id="message" name="message" rows="6" maxlength="3000" required><%= values.message || "" %></textarea>
      </div>

      <button type="submit" class="btn primary-btn block">Submit enquiry</button>
    </form>
  </div>

  <div class="card info-card">
    <h3>We can help with</h3>
    <ul>
      <li>Ticket booking problems</li>
      <li>Event availability questions</li>
      <li>Payment and booking confirmations</li>
      <li>Corporate event enquiries</li>
      <li>General platform support</li>
    </ul>
    <p class="note">Enquiries are reviewed by our admin team, usually within one business day.</p>
  </div>
</section>

<% if (currentUser && currentUser.role === "admin") { %>
  <section class="card" id="enquiries">
    <div class="card-header">
      <h3>Enquiry inbox</h3>
    </div>

    <% if (enquiries.length === 0) { %>
      <p class="muted">No enquiries have been submitted yet.</p>
    <% } else { %>
      <div class="table-container">
        <table>
          <thead>
            <tr>
              <th>From</th>
              <th>Subject &amp; message</th>
              <th>Status</th>
              <th>Received</th>
              <th><span class="visually-hidden">Actions</span></th>
            </tr>
          </thead>
          <tbody>
            <% enquiries.forEach((enquiry) => { %>
              <tr>
                <td><%= enquiry.name %><br><a href="mailto:<%= enquiry.email %>" class="small"><%= enquiry.email %></a></td>
                <td><strong><%= enquiry.subject %></strong><p class="enquiry-message"><%= enquiry.message %></p></td>
                <td><span class="status <%= enquiry.status.toLowerCase().replace(" ", "-") %>"><%= enquiry.status %></span></td>
                <td><%= fmt.dateTime(enquiry.createdAt) %></td>
                <td class="actions">
                  <form action="/contact/<%= enquiry._id %>/status" method="POST" class="inline-form">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <select name="status" aria-label="Status">
                      <% statuses.forEach((status) => { %>
                        <option value="<%= status %>" <%= enquiry.status === status ? "selected" : "" %>><%= status %></option>
                      <% }) %>
                    </select>
                    <button type="submit" class="btn secondary-btn small-btn">Update</button>
                  </form>
                  <form action="/contact/<%= enquiry._id %>/delete" method="POST" data-confirm="Delete this enquiry?">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button type="submit" class="btn danger-btn small-btn">Delete</button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </section>
<% } %>

<%- include("partials/foot") %>
