<%- include("../partials/head") %>

<section class="card narrow">
  <h2>Create an account</h2>
  <p class="muted">Register to book tickets and keep track of your events.</p>

  <%- include("../partials/errors") %>

  <form action="/register" method="POST">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

    <div class="form-group">
      <label for="name">Full name</label>
      <input type="text" id="name" name="name" value="<%= values.name || "" %>" autocomplete="name" minlength="2" required>
    </div>

    <div class="form-group">
      <label for="email">Email address</label>
      <input type="email" id="email" name="email" value="<%= values.email || "" %>" autocomplete="email" required>
    </div>

    <div class="form-group">
      <label for="password">Password <span class="muted small">(at least 8 characters)</span></label>
      <div class="password-field">
        <input type="password" id="password" name="password" autocomplete="new-password" minlength="8" required>
        <button type="button" class="toggle-password" data-toggle-password="password" aria-label="Show password">Show</button>
      </div>
    </div>

    <div class="form-group">
      <label for="confirmPassword">Confirm password</label>
      <div class="password-field">
        <input type="password" id="confirmPassword" name="confirmPassword" autocomplete="new-password" minlength="8" required>
        <button type="button" class="toggle-password" data-toggle-password="confirmPassword" aria-label="Show password">Show</button>
      </div>
    </div>

    <div class="form-group">
      <span class="label">Account Type</span>
      <label class="radio-option">
        <input type="radio" name="accountType" value="user" <%= values.accountType !== "organiser" ? "chacked" : "" %>>
        I want to book events
      </label>
      <label class="radio-option">
        <input type="radio" name="accountType" value="organiser" <%= values.accountType !== "user" ? "checked" : "" %>>
        I want to host events
      </label>
    </div>

    <button type="submit" class="btn primary-btn block">Register</button>
  </form>

  <p class="switch-auth">Already have an account? <a href="/login">Log in</a></p>
</section>

<%- include("../partials/foot") %>
