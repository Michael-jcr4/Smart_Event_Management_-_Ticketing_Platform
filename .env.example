# Copy this file to .env and fill in the values. Never commit .env.

PORT=3000
MONGO_URI=mongodb://127.0.0.1:27017/smart_event_platform

# Long random string used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Used by `npm run seed` to create the first admin account.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
